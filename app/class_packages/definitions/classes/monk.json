      "resources": [
        {
          "key": "stunning_fist",
          "name": "Stunning Fist",
          "feature_tokens": ["stunning-fist"],
          "progression": "level",
          "description": "Daily Stunning Fist attempts equal the retained Monk level. Declare the attempt before the attack roll; a miss still spends the attempt. The save DC is 10 + half character level + Wisdom modifier."
        },
        {
          "key": "still_mind_applies",
          "name": "Still Mind Applies",
          "feature_tokens": ["still-mind"],
          "progression": "one",
          "description": "Enable only for a saving throw against an enchantment spell or effect; the +2 bonus is then applied to that saving throw.",
          "can_activate": true,
          "recover_on_full_rest": false,
          "end_on_full_rest": false,
          "tracks_uses": false
        },
        {
          "key": "high_jump",
          "name": "High Jump",
          "feature_tokens": ["high-jump"],
          "progression": "zero",
          "description": "Spend 1 ki point as a swift action. Until the end of the turn, add the Monk level to Acrobatics checks made to jump and count as having a running start.",
          "can_activate": true,
          "activate_on_spend": true,
          "tracks_uses": false,
          "external_cost_key": "ki_pool",
          "use_cost": 1
        },
        {
          "key": "wholeness_of_body",
          "name": "Wholeness of Body",
          "feature_tokens": ["wholeness-of-body"],
          "progression": "zero",
          "description": "Spend 2 ki points as a standard action to heal hit points equal to the retained Monk level.",
          "tracks_uses": false,
          "external_cost_key": "ki_pool",
          "use_cost": 2
        },
        {
          "key": "abundant_step",
          "name": "Abundant Step",
          "feature_tokens": ["abundant-step"],
          "progression": "zero",
          "description": "Spend 2 ki points as a move action to use dimension door with caster level equal to the retained Monk level; the Monk cannot take other creatures.",
          "tracks_uses": false,
          "external_cost_key": "ki_pool",
          "use_cost": 2
        },
        {
          "key": "quivering_palm",
          "name": "Quivering Palm",
          "feature_tokens": ["quivering-palm"],
          "progression": "one",
          "description": "Once per day, declare a quivering-palm unarmed strike. A successful hit can later be triggered within a number of days equal to the Monk level; Fortitude negates. Only one target can carry the vibrations at a time."
        },
        {
          "key": "empty_body",
          "name": "Empty Body",
          "feature_tokens": ["empty-body"],
          "progression": "zero",
          "description": "Spend 3 ki points as a move action to become ethereal for 1 minute, as etherealness.",
          "tracks_uses": false,
          "external_cost_key": "ki_pool",
          "use_cost": 3
        }
      ]
    }

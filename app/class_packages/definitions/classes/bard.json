          "feature_tokens": ["lore-master"],
          "progression": "bard_lore_master_uses",
          "description": "Uses per day of Lore Master. Each use allows taking 20 on one Knowledge check; the Bard may always take 10 on Knowledge checks."
        },
        {
          "key": "well_versed",
          "name": "Well-Versed Applies",
          "feature_tokens": ["well-versed"],
          "progression": "one",

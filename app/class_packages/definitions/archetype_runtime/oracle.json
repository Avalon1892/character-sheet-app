          "label": "Bonded Spirit",
          "feature_tokens": ["bonded-spirit"],
          "option_families": ["shaman_spirit"],
          "minimum": 1,
          "maximum": 1,
          "description": "Choose the Shaman spirit bonded for the current day. At Oracle 4 its spirit-magic spells become temporary spells known up to the spell levels the Oracle can cast; later spirit abilities remain documented with the choice."

    {
      "key": "pathfinder-archetype:pathfinder-class:oracle:planar-oracle",
      "choice_providers": [
        {
          "key": "planar-oracle-plane",
          "label": "Outer Plane Affinity",
          "feature_tokens": ["planar-resistance"],
          "minimum": 1,
          "maximum": 1,
          "description": "Choose the permanent Outer Plane with which the Oracle has affinity.",
          "fixed_options": [
            {"key": "abaddon", "name": "Abaddon", "description": "Neutral evil Outer Plane."},
            {"key": "abyss", "name": "The Abyss", "description": "Chaotic evil Outer Plane."},
            {"key": "axis", "name": "Axis", "description": "Lawful neutral Outer Plane."},
            {"key": "boneyard", "name": "The Boneyard", "description": "Neutral Outer Plane."},
            {"key": "elysium", "name": "Elysium", "description": "Chaotic good Outer Plane."},
            {"key": "heaven", "name": "Heaven", "description": "Lawful good Outer Plane."},
            {"key": "hell", "name": "Hell", "description": "Lawful evil Outer Plane."},
            {"key": "maelstrom", "name": "The Maelstrom", "description": "Chaotic neutral Outer Plane."},
            {"key": "nirvana", "name": "Nirvana", "description": "Neutral good Outer Plane."}
          ]
        },
        {
          "key": "planar-oracle-energy",
          "label": "Associated Energy",
          "feature_tokens": ["planar-resistance"],
          "minimum": 1,
          "maximum": 1,
          "depends_on": "planar-oracle-plane",
          "description": "Choose an energy type associated with the selected plane. Planar Resistance grants resistance 10, increasing to 20 at level 11 and immunity at level 20.",
          "fixed_options": [
            {"key": "acid", "name": "Acid", "description": "Associated acid resistance."},
            {"key": "cold", "name": "Cold", "description": "Associated cold resistance."},
            {"key": "electricity", "name": "Electricity", "description": "Associated electricity resistance."},
            {"key": "fire", "name": "Fire", "description": "Associated fire resistance."}
          ]
        }
      ],
      "system_features": ["planar-resistance"]
    },
    {
      "key": "spheres-archetype:pathfinder-class:oracle:augur",
      "resource_modules": [
        {
          "key": "augur",
          "title": "Augur Kismet",
          "governing_ability": "charisma",
          "resources": [
            {
              "key": "kismet",
              "name": "Kismet",
              "feature_tokens": ["kismet"],
              "progression": "ability_modifier_minimum_one",
              "description": "A fluctuating pool equal to Charisma modifier (minimum 1). Spend it on retained deeds; qualifying natural 1s restore it."
            }
          ]
        }
      ],
      "system_features": ["kismet"]
    },
    {

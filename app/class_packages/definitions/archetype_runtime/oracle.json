{
  "version": 1,
  "class_key": "pathfinder-class:oracle",
  "entries": [
    {
      "key": "pathfinder-archetype:pathfinder-class:oracle:dual-cursed-oracle",
      "suppress_choice_class_skills": ["oracle-mystery"],
      "choice_provider_overrides": [
        {
          "key": "oracle-curse",
          "minimum": 2,
          "maximum": 2,
          "label": "Oracle's Curses",
          "description": "Choose two curses. One progresses normally; the curse selected in the linked Stunted Curse choice never gains its later benefits."
        }
      ],
      "choice_providers": [
        {
          "key": "dual-cursed-stunted-curse",
          "label": "Stunted Curse",
          "feature_tokens": ["oracle-s-curse"],
          "minimum": 1,
          "maximum": 1,
          "depends_on": "oracle-curse",
          "options_from_dependency": true,
          "description": "Choose which of the two curses does not improve as Oracle level increases."
        }
      ],
      "system_features": ["dual-cursed-stunted-curse"]
    },
    {"key": "pathfinder-archetype:pathfinder-class:oracle:ancient-lorekeeper", "suppress_choice_class_skills": ["oracle-mystery"]},

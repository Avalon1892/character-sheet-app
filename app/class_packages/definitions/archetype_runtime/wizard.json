      "resource_modules": [
        {"key": "hallowed_necromancer", "title": "Hallowed Necromancer", "governing_ability": "intelligence", "resources": [
          {"key": "positive_touch", "name": "Positive Touch", "feature_tokens": ["positive-touch"], "progression": "three_plus_ability", "description": "Daily empowered positive-touch uses equal 3 + Intelligence modifier. Sacrifice a prepared necromancy spell to cast a same-or-lower cure spell that harms undead only; spending two uses also activates Death Bane where applicable."}
        ]}
      ],
      "system_features": ["positive-touch", "death-bane"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:pact-wizard-ff",

{
  "version": 1,
  "class_key": "pathfinder-class:wizard",
  "entries": [
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:arcane-bomber",
      "resource_adjustments": [
        {"resource_key": "bombs", "choice_options": ["Acid", "Cold", "Electricity", "Fire"], "maximum_choices_levels": [1], "description": "Bombs per day equal Wizard level + Intelligence modifier. Choose acid, cold, electricity, or fire permanently; bomb damage scales by combined qualifying bomb levels."}
      ],
      "system_features": ["bomb"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:arcane-warden",
      "choice_option_filters": [{"key": "arcane-school", "include_names": ["Universalist School"]}]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:exploiter-wizard",
      "power_providers": [
        {"key": "exploiter-wizard-exploits", "label": "Arcanist Exploits", "family": "arcanist_exploit", "feature_tokens": ["exploiter-exploit"], "slot_levels": [1, 5, 9, 13, 17], "description": "Choose one Arcanist exploit at 1st level and every 4 Wizard levels thereafter. Wizard level counts as Arcanist level for effects, DCs, and prerequisites."}
      ],
      "system_features": ["arcane-reservoir", "exploiter-exploit"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:familiar-adept",

        {"key": "opposition-schools", "minimum": 3, "maximum": 3}
      ],
      "choice_option_filters": [{"key": "arcane-bond", "include_names": ["Familiar"]}],
      "system_features": ["familiar"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:hallowed-necromancer",

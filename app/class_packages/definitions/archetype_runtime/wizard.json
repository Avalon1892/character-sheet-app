      "choice_providers": [
        {"key": "runesage-specialization", "label": "Runic Specialization", "feature_tokens": ["runic-focus"], "minimum": 1, "maximum": 1, "description": "Choose the Thassilonian school represented by the current runic focus.", "fixed_options": [
          {"key": "envy", "name": "Envy (Abjuration)"}, {"key": "gluttony", "name": "Gluttony (Necromancy)"}, {"key": "greed", "name": "Greed (Transmutation)"}, {"key": "lust", "name": "Lust (Enchantment)"}, {"key": "pride", "name": "Pride (Illusion)"}, {"key": "sloth", "name": "Sloth (Conjuration)"}, {"key": "wrath", "name": "Wrath (Evocation)"}
        ]}
      ],
      "system_features": ["runic-focus"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:spellbinder",
      "audit_ignore_mechanics": ["alchemist_discovery"],
      "choice_providers": [
        {"key": "spellbinder-bonded-spells", "label": "Bonded Spells", "feature_tokens": ["spell-bond"], "minimum": 1, "maximum": 9, "maximum_levels": [1, 3, 5, 7, 9, 11, 13, 15, 17], "spell_lists": ["Wizard"], "description": "Choose one known Wizard spell at 1st level and every 2 levels thereafter. A bonded spell can replace a prepared spell of the same or higher level as a full-round action."}
      ],
      "system_features": ["spell-bond"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:spirit-whisperer",
      "choice_option_filters": [{"key": "arcane-bond", "include_names": ["Familiar"]}],
      "choice_providers": [
        {"key": "spirit-whisperer-spirit", "label": "Shaman Spirit", "feature_tokens": ["spirit-link"], "option_families": ["shaman_spirit"], "minimum": 1, "maximum": 1, "description": "Choose the Shaman spirit that grants the familiar's spirit-animal ability and the Wizard's spirit, greater, and manifestation abilities."}
      ],
      "power_providers": [
        {"key": "spirit-whisperer-hexes", "label": "Spirit Hexes", "family": "shaman_hex", "feature_tokens": ["spirit-hex"], "slot_levels": [5, 10, 15, 20], "description": "Choose hexes from the selected spirit at the archetype's listed levels; Wizard level and Intelligence determine their effects and DCs."}
      ],
      "system_features": ["familiar", "spirit-link", "spirit-hex"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:wind-listener",
      "choice_option_filters": [{"key": "opposition-schools", "exclude_names": ["Divination School", "Illusion School"]}]

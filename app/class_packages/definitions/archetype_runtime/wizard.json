      "choice_option_filters": [
        {"key": "arcane-bond", "include_names": ["Familiar"]},
        {"key": "opposition-schools", "exclude_names": ["Conjuration School"]}
      ],
      "choice_providers": [
        {"key": "pact-wizard-outsider-patron", "label": "Outsider Patron", "feature_tokens": ["pact"], "minimum": 1, "maximum": 1, "description": "Choose the outsider subtype of the patron and future improved familiar.", "fixed_options": [
          {"key": "agathion", "name": "Agathion"}, {"key": "angel", "name": "Angel"}, {"key": "archon", "name": "Archon"}, {"key": "azata", "name": "Azata"}, {"key": "daemon", "name": "Daemon"}, {"key": "demon", "name": "Demon"}, {"key": "devil", "name": "Devil"}, {"key": "div", "name": "Div"}, {"key": "inevitable", "name": "Inevitable"}, {"key": "protean", "name": "Protean"}, {"key": "psychopomp", "name": "Psychopomp"}
        ]}
      ],
      "system_features": ["familiar", "pact"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:pact-wizard-hhh",
      "choice_providers": [
        {"key": "pact-wizard-patron", "label": "Witch Patron", "feature_tokens": ["patron-spells"], "option_families": ["witch_patron"], "minimum": 1, "maximum": 1, "description": "Choose a Witch patron. Its patron spells are added to the spellbook at the appropriate levels and can be used for spontaneous conversion."}
      ],
      "spell_grant_choice_providers": ["pact-wizard-patron"],
      "system_features": ["patron-spells"]
    },
    {
      "key": "pathfinder-archetype:pathfinder-class:wizard:runesage",

        {
          "key": "idealist-planar-bond",
          "label": "Planar Bond",
          "feature_tokens": ["planar-bond"],
          "minimum": 1,
          "maximum": 1,
          "description": "Choose the deity's home plane. Its 1st-, 4th-, and 7th-level spells become additional spontaneous conversion options.",
          "fixed_options": [
            {"key": "abaddon", "name": "Abaddon", "description": "Protection from good; unholy blight; blasphemy."},
            {"key": "abyss", "name": "Abyss", "description": "Doom; unholy blight; blasphemy."},
            {"key": "astral", "name": "Astral Plane", "description": "Summon monster I; dismissal; lesser create demiplane."},
            {"key": "axis", "name": "Axis", "description": "Protection from chaos; order's wrath; dictum."},
            {"key": "boneyard", "name": "Boneyard", "description": "Deathwatch; death ward; arbitrament."},
            {"key": "elysium", "name": "Elysium", "description": "Remove fear; freedom of movement; word of chaos."},
            {"key": "ethereal", "name": "Ethereal Plane", "description": "Obscuring mist; sending; ethereal jaunt."},
            {"key": "first-world", "name": "First World", "description": "Entropic shield; giant vermin; regenerate."},
            {"key": "heaven", "name": "Heaven", "description": "Sanctuary; discern lies; holy word."},
            {"key": "hell", "name": "Hell", "description": "Command; tongues; dictum."},
            {"key": "maelstrom", "name": "Maelstrom", "description": "Protection from law; chaos hammer; word of chaos."},
            {"key": "nirvana", "name": "Nirvana", "description": "Protection from evil; holy smite; holy word."},
            {"key": "air", "name": "Plane of Air", "description": "Alter winds; air walk; control weather."},
            {"key": "earth", "name": "Plane of Earth", "description": "Magic stone; stoneskin; statue."},
            {"key": "fire", "name": "Plane of Fire", "description": "Produce flame; wall of fire; delayed blast fireball."},
            {"key": "water", "name": "Plane of Water", "description": "Hydraulic push; control water; vortex."},
            {"key": "shadow", "name": "Shadow Plane", "description": "Cause fear; shadow conjuration; destruction."},
            {"key": "other", "name": "Other Plane", "description": "Use the custom planar-bond rules agreed with the GM."}
          ]
        }
      ],
      "system_features": ["planar-bond"]
    },

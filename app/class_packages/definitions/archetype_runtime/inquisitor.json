              "feature_tokens": ["revealing-gaze"],
              "progression": "one",
              "description": "Toggle for opposed Perception checks against a creature's Disguise or Stealth. Half Inquisitor level is added as a morale bonus.",
              "can_activate": true,
              "tracks_uses": false,
              "recover_on_full_rest": false,
              "end_on_full_rest": false
            },
            {
              "key": "escape_corruptions_grasp",
              "name": "Escape Corruption's Grasp",
              "feature_tokens": ["escape-corruption-s-grasp"],
              "progression": "level",
              "description": "Rounds per day equal Inquisitor level. Activate as an immediate action to ignore movement impediments as freedom of movement.",
              "can_activate": true,
              "use_requires_active": true
            }
          ]
        }
      ],
      "passive_effects": [
        {"key": "revealing-gaze", "feature_tokens": ["revealing-gaze"], "targets": ["skill:perception"], "progression": "half_level_minimum_one", "bonus_type": "morale", "source": "Inquisitor (Abolisher): Revealing Gaze", "requires_resource_active": "revealing_gaze"}
      ],
      "system_features": ["domain", "revealing-gaze", "escape-corruption-s-grasp"]
